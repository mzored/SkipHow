{
  "schema_version": 1,
  "id": "batch-intake",
  "title": "Batch intake",
  "source_requirement": "16.3.6",
  "intent": "INTAKE",
  "execution_shape": "EXECUTE",
  "fixture": {"kind": "synthetic_tracker", "profile": "mixed-overlapping-signals"},
  "request": {"user_message": "Sort these customer notes, combine duplicates, and save the actionable work."},
  "preconditions": ["Persistence is explicitly authorized.", "Input contains bugs, ideas, feedback, and two duplicate reports."],
  "grading": {
    "pass_condition": "all_required_outcomes_and_no_forbidden_effects",
    "required_outcomes": [
      {"id": "signals-atomized", "observation": "intake.atomic_signal_count", "operator": "equals", "expected": 6, "evidence": ["intake_receipt"]},
      {"id": "duplicates-merged", "observation": "intake.canonical_work_item_count", "operator": "equals", "expected": 4, "evidence": ["intake_receipt", "tracker_state"]},
      {"id": "provenance-preserved", "observation": "intake.signals_with_provenance", "operator": "equals", "expected": 6, "evidence": ["tracker_state"]}
    ],
    "forbidden_effects": [
      {"id": "no-signal-loss", "observation": "intake.unaccounted_signal_count", "operator": "greater_than", "expected": 0, "evidence": ["intake_receipt"]},
      {"id": "no-duplicate-work-items", "observation": "tracker.duplicate_items_created", "operator": "greater_than", "expected": 0, "evidence": ["mutation_log", "tracker_state"]},
      {"id": "no-implementation", "observation": "mutations.project_files", "operator": "greater_than", "expected": 0, "evidence": ["mutation_log"]}
    ]
  }
}
