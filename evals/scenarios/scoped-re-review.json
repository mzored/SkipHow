{
  "schema_version": 1,
  "id": "scoped-re-review",
  "title": "Scoped re-review",
  "source_requirement": "16.3.8",
  "intent": "CHANGE",
  "execution_shape": "EXECUTE",
  "fixture": {"kind": "synthetic_repository", "profile": "review-finding-local-test-fix"},
  "request": {"user_message": "Address the review finding and finish verification."},
  "preconditions": ["The finding changes only one local test seam and no public contract or protected surface."],
  "grading": {
    "pass_condition": "all_required_outcomes_and_no_forbidden_effects",
    "required_outcomes": [
      {"id": "finding-resolved", "observation": "findings.review_item.disposition", "operator": "equals", "expected": "RESOLVED", "evidence": ["diff", "targeted_review_receipt"]},
      {"id": "invalidated-evidence-rerun", "observation": "checks.rerun_set", "operator": "set_equals", "expected": ["local_unit", "affected_integration"], "evidence": ["command_receipts"]}
    ],
    "forbidden_effects": [
      {"id": "no-full-review-restart", "observation": "reviews.full_lifecycle_restart_count", "operator": "greater_than", "expected": 0, "evidence": ["event_log"]},
      {"id": "no-unaffected-check-rerun", "observation": "checks.unaffected_rerun_count", "operator": "greater_than", "expected": 0, "evidence": ["command_receipts"]}
    ]
  }
}
