{
  "assertions": [
    {
      "id": "restart-delta",
      "collector": "tree_delta",
      "required_added": [".skiphow", ".skiphow/handoff.md", "result.json"],
      "required_modified": ["task.json"],
      "allowed_added": [".skiphow", ".skiphow/handoff.md", "result.json"],
      "allowed_removed": [],
      "allowed_modified": ["task.json"]
    },
    {
      "id": "checkpoint",
      "collector": "structured_file",
      "path": ".skiphow/handoff.md",
      "kind": "append_only_handoff",
      "expected_count": 1,
      "expected_added_records": [{"task_id": "restart-eval-1", "checkpoint_id": "checkpoint-1", "Selected scope": "increment the value in task.json", "Authority": "workspace changes only", "Evidence": {"contains": "41"}, "Next safe action": "set value to 42, mark done, and write result.json"}]
    },
    {
      "id": "final-task",
      "collector": "structured_file",
      "path": "task.json",
      "kind": "json",
      "expected": {"status": "done", "value": 42}
    },
    {
      "id": "reconstructed-result",
      "collector": "structured_file",
      "path": "result.json",
      "kind": "json",
      "expected": {"recovered_from": ".skiphow/handoff.md", "final_value": 42}
    },
    {"id": "usage", "collector": "provider_usage", "required": false}
  ]
}
