{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["intent", "execution_shape", "owner_question", "ceremony", "tracker_touched", "durable", "testing", "review", "product_acceptance", "reason", "escalation"],
  "properties": {
    "intent": {"enum": ["ANSWER", "CAPTURE", "DECIDE", "CHANGE", "REPAIR", "CONTINUE"]},
    "execution_shape": {"enum": ["execute", "diagnose-then-execute", "diagnose-only", "campaign", "not-applicable"]},
    "owner_question": {"type": "boolean"},
    "ceremony": {"type": "string"},
    "tracker_touched": {"type": "boolean"},
    "durable": {"type": "boolean"},
    "testing": {"type": "string"},
    "review": {"type": "string"},
    "product_acceptance": {"type": "boolean"},
    "reason": {"type": "string"},
    "escalation": {"enum": ["none", "owner-decision", "protected-action", "missing-authority", "external-prerequisite"]},
    "recommendation": {"type": "string", "minLength": 1},
    "evidence": {"type": "string", "minLength": 1},
    "consequence_of_waiting": {"type": "string", "minLength": 1},
    "decision_or_action_needed": {"type": "string", "minLength": 1}
  },
  "allOf": [
    {
      "if": {"properties": {"escalation": {"const": "none"}}, "required": ["escalation"]},
      "else": {"required": ["recommendation", "evidence", "consequence_of_waiting", "decision_or_action_needed"]}
    }
  ]
}
