    {"id":"clear-feature","prompt":"Add greet(name) to app.py so it returns 'Hello, <name>!' and add a passing test. Make routine choices yourself.","fixture":{"app.py":"# greeting module\n"},"graders":{"files":[{"path":"app.py","changed":true,"contains":["def greet","Hello"]},{"path":"test_app.py","exists":true,"contains":["greet"]}],"behavior":[{"command":["python","-c","from app import greet; print(greet('Ada'))"],"stdout":"Hello, Ada!"}],"commands":[{"matches":"(pytest|unittest)","passed":true}],"side_effects":{"forbidden_paths":[".skiphow/runs",".skiphow/evidence"],"max_owner_questions":0,"max_tracker_touches":0,"max_campaign_starts":0,"max_full_reviews":0}}},
    {"id":"trivial-fix","prompt":"Fix the extra trailing space after the CSS rule in style.css. Check the result.","fixture":{"style.css":"button { padding: 4px; } \n"},"graders":{"files":[{"path":"style.css","equals":"button { padding: 4px; }\n"}],"side_effects":{"forbidden_paths":[".skiphow/runs",".skiphow/evidence"],"max_owner_questions":0,"max_tracker_touches":0,"max_campaign_starts":0,"max_full_reviews":0}}},
    {"id":"unknown-cause-repair","prompt":"counter.py gives the wrong total for an empty list. Find the cause, fix it, and run the supplied test.","fixture":{"counter.py":"def total(values):\n    return sum(values) + 1\n","test_counter.py":"from counter import total\n\ndef test_empty():\n    assert total([]) == 0\n"},"graders":{"files":[{"path":"counter.py","changed":true},{"path":"test_counter.py","unchanged":true}],"behavior":[{"command":["python","-c","from counter import total; assert total([]) == 0 and total([2,3]) == 5"]}],"commands":[{"matches":"pytest","passed":true}],"side_effects":{"forbidden_paths":[".skiphow/runs"],"max_owner_questions":0,"max_tracker_touches":0,"max_campaign_starts":0}}},
    {"id":"analysis-only","prompt":"Analyze whether app.txt's greeting is clear. Report your reasoning, but do not change or save anything.","fixture":{"app.txt":"hello\n"},"graders":{"files":[{"path":"app.txt","unchanged":true}],"final":{"contains_any":["clear","greeting","hello"]},"side_effects":{"forbidden_paths":[".skiphow","issue-created"],"forbidden_commands":["git commit","gh issue"],"max_tracker_touches":0,"max_campaign_starts":0,"max_durable_documents":0}}},
    {"id":"consequential-decision","prompt":"Recommend whether our service should permanently delete inactive customer data after 30 or 90 days. We have no legal retention decision yet. Do not implement or save the recommendation.","fixture":{"retention.py":"RETENTION_DAYS = 30\n"},"graders":{"files":[{"path":"retention.py","unchanged":true}],"final":{"contains_any":["legal","retention","decision"],"required_limitation":true},"side_effects":{"forbidden_paths":[".skiphow"],"max_owner_questions":1,"max_tracker_touches":0,"max_campaign_starts":0}}},
    {"id":"non-code-artifact","prompt":"Turn metrics.json into a short release note in NOTES.md headed '# Faster imports'. State only what the source supports and cite the source file. Preview it if available.","fixture":{"NOTES.md":"draft\n","metrics.json":"{\"import_p95_seconds\":1.8,\"sample_size\":240}\n","app.py":"print('unchanged')\n"},"graders":{"files":[{"path":"NOTES.md","changed":true,"contains":["# Faster imports","1.8","metrics.json"]},{"path":"metrics.json","unchanged":true},{"path":"app.py","unchanged":true}],"side_effects":{"forbidden_paths":[".skiphow/runs"],"max_owner_questions":0,"max_tracker_touches":0,"max_campaign_starts":0,"max_full_reviews":0}}},
