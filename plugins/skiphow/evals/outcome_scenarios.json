    {"id":"tiny-auth-fix","prompt":"Fix auth.py so is_admin is true only for the exact role 'admin'. Add a focused near-miss test for 'administrator' and run it.","fixture":{"auth.py":"def is_admin(role):\n    return role.startswith('admin')\n","test_auth.py":"from auth import is_admin\n\ndef test_admin():\n    assert is_admin('admin')\n"},"graders":{"files":[{"path":"auth.py","changed":true},{"path":"test_auth.py","changed":true,"contains":["administrator"]}],"behavior":[{"command":["python","-c","from auth import is_admin; assert is_admin('admin') is True and is_admin('administrator') is False and is_admin('Admin') is False"]}],"commands":[{"matches":"pytest","passed":true}],"side_effects":{"forbidden_paths":[".skiphow/runs"],"max_owner_questions":0,"max_tracker_touches":0,"max_campaign_starts":0,"full_reviews":{"max":1}}}},
