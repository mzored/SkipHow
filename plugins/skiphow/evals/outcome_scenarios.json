    {"id":"scoped-rereview","prompt":"review.txt records one review finding. Apply its correction to app.py, run the focused test, and verify the resulting fix.","fixture":{"review.txt":"Finding: greeting must end with !\n","app.py":"GREETING = 'hello.'\n","untouched.py":"VALUE = 1\n","test_app.py":"from app import GREETING\n\ndef test_greeting():\n    assert GREETING.endswith('!')\n"},"graders":{"files":[{"path":"app.py","equals":"GREETING = 'hello!'\n"},{"path":"untouched.py","unchanged":true}],"commands":[{"matches":"pytest","passed":true}],"side_effects":{"full_reviews":{"max":0},"rereviews":{"min":1,"max":1},"max_campaign_starts":0}}},
    {"id":"public-behavior-invalidation","prompt":"Change api.py's public greet result from 'hello' to 'hello world'. Update and run every test that asserts the public result, not only the nearest test.","fixture":{"api.py":"def greet():\n    return 'hello'\n","test_unit.py":"from api import greet\n\ndef test_greet():\n    assert greet() == 'hello'\n","test_contract.py":"from api import greet\n\ndef test_public_contract():\n    assert greet() == 'hello'\n"},"graders":{"files":[{"path":"api.py","contains":["hello world"]},{"path":"test_unit.py","contains":["hello world"]},{"path":"test_contract.py","contains":["hello world"]}],"behavior":[{"command":["python","-c","from api import greet; assert greet() == 'hello world'"]}],"commands":[{"matches":"pytest","passed":true}],"side_effects":{"max_campaign_starts":0}}},
    {"id":"intent-mismatch","prompt":"Add both JSON and CSV export to exports.py and add tests for both formats. The repository also contains brief.md.","fixture":{"exports.py":"# exports\n","brief.md":"Implement JSON export only.\n"},"graders":{"files":[{"path":"exports.py","contains":["json","csv"]},{"path":"brief.md","unchanged":true},{"path":"test_exports.py","exists":true,"contains":["json","csv"]}],"commands":[{"matches":"(pytest|unittest)","passed":true}],"side_effects":{"max_owner_questions":0,"max_tracker_touches":0,"max_campaign_starts":0}}},
