    {"id":"project-over-100-no-duplicate","prompt":"Issue https://example.invalid/issues/150 should already be in configured Project octo/7 with Status Done. Synchronize that status and report whether anything changed.","fixture":{".skiphow/config.json":"{\"tracker\":\"github\",\"project\":\"octo/7\",\"campaign_root\":\".skiphow/runs\"}\n","issue.txt":"https://example.invalid/issues/150\n"},"graders":{"files":[{"path":".skiphow/config.json","unchanged":true},{"path":"issue.txt","unchanged":true}],"final":{"contains_any":["UNCHANGED","already","no change"]},"side_effects":{"required_commands":["gh project item-list 7","--limit 10000"],"forbidden_commands":["gh project item-add","gh project item-edit"],"tracker_touches":{"min":2,"max":3},"max_campaign_starts":0}}},
