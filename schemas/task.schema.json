{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skiphow.dev/schemas/task.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["task_id", "run_id", "outcome", "constraints", "status", "revision", "dependencies", "priority", "created_at", "updated_at", "next_action", "failure_count", "schema_version"],
  "properties": {
    "task_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "outcome": {"type": "string", "minLength": 1},
    "constraints": {"type": "array", "items": {"type": "string"}},
    "status": {"enum": ["PROPOSED", "READY", "CLAIMED", "RUNNING", "WAITING_EXTERNAL", "VERIFYING", "DONE", "BLOCKED", "CIRCUIT_BROKEN", "FAILED", "CANCELLED", "SUPERSEDED"]},
    "revision": {"type": "integer", "minimum": 0},
    "dependencies": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "priority": {"type": "integer"},
    "created_at": {"type": "string"},
    "updated_at": {"type": "string"},
    "next_action": {"type": "string"},
    "failure_signature": {"type": ["string", "null"]},
    "failure_count": {"type": "integer", "minimum": 0},
    "schema_version": {"const": 1}
  }
}
