{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skiphow.dev/schemas/config.schema.json",
  "title": "SkipHow project configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version"],
  "properties": {
    "schema_version": {"const": 2},
    "tracker": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {"enum": ["auto", "none", "github", "local"]},
        "project": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*/[1-9][0-9]*$"}
      }
    },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "merge_policy": {"enum": ["never", "when_green", "when_green_and_approved", "auto_merge_or_queue"]},
        "cleanup": {"enum": ["merged_only", "never"]}
      }
    },
    "findings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {"persist": {"enum": ["local", "tracker", "ask", "off"]}}
    },
    "campaign_root": {"type": "string", "minLength": 1}
  }
}
