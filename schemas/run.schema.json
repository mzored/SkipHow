{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skiphow.dev/schemas/run.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["run_id", "schema_version", "original_request", "authority", "status", "revision", "created_at", "updated_at", "budget", "cancel_requested", "next_action"],
  "properties": {
    "run_id": {"type": "string", "minLength": 1},
    "schema_version": {"const": 2},
    "original_request": {"type": "string", "minLength": 1},
    "authority": {"type": "object"},
    "status": {"enum": ["NEW", "READY", "RUNNING", "WAITING_EXTERNAL", "PAUSED", "VERIFYING", "COMPLETED", "BLOCKED", "FAILED", "CANCELLED"]},
    "revision": {"type": "integer", "minimum": 0},
    "created_at": {"type": "string"},
    "updated_at": {"type": "string"},
    "budget": {"type": "object"},
    "cancel_requested": {"type": "boolean"},
    "next_action": {"type": "string"}
  }
}
